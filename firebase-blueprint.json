{
  "collections": [
    {
      "name": "users",
      "description": "Global user profiles and rankings.",
      "fields": {
        "name": "string",
        "wins": "number",
        "wordsFound": "number",
        "totalScore": "number"
      }
    },
    {
      "name": "rooms",
      "description": "Multiplayer game rooms.",
      "fields": {
        "hostId": "string",
        "status": "string",
        "board": "array",
        "gridSize": "number",
        "minWordLength": "number",
